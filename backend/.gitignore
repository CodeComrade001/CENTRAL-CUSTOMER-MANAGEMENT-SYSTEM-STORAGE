# Node modules (always ignore this)
node_modules/

# Output folders (from TypeScript, build tools, etc.)
dist/
build/
out/

# Environment and secret files
.env
.env.*        # For .env.development, .env.production, etc.

# System files
.DS_Store     # macOS
Thumbs.db     # Windows
*.log         # Log files like npm-debug.log

# TypeScript cache
*.tsbuildinfo

# Editor settings
.vscode/
.idea/

# Testing & coverage
coverage/
*.lcov

# Optional: ignore local SQLite or dev DBs
*.sqlite
*.sqlite3

# Optional: ignore yarn or pnpm
yarn.lock
pnpm-lock.yaml


# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
