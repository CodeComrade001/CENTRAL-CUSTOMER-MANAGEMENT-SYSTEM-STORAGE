# Use Node 20 with Alpine for smaller size but modern crypto API
FROM node:lts-alpine

# Install file-watching prerequisites
RUN apk add  \
  bash \
  coreutils \
  busybox-extras \
  inotify-tools

# Set working directory
WORKDIR /usr/src/app

# Install dependencies first (leveraging cache)
COPY package*.json ./
RUN npm install

# Copy the rest of the project files
COPY . .

RUN chown -R node /usr/src/app

# Expose Vite's default dev server port
EXPOSE 5173

# Run Vite in dev mode and allow external connections
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
